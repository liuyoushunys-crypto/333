(fn fib (n)
  (let-mut a = 0)
  (let-mut b = 1)
  (define (iter i)
    (if (< i n)
      (begin
        (let-mut t = (+ a b))
        (set a = b)
        (set b = t)
        (iter (+ i 1)))))
  (iter 0)
  (display "fib(") (display n) (display ") = ") (display a) (newline))
(fib 10)

(fn classify (n)
  (match (zero? #{n % 2})
    (#t (display n) (display " is even") (newline))
    (#f (display n) (display " is odd") (newline))))
(classify 7)

(fn filter-pos (lst)
  (let-mut result = (vec))
  (define (walk xs)
    (if (pair? xs)
      (begin
        (if (> (car xs) 0)
          (push result (car xs)))
        (walk (cdr xs)))))
  (walk lst)
  (display "positives: ") (display result) (newline))
(filter-pos (list 3 -1 0 5 -2 7))


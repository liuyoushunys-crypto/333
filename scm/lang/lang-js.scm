(display "=== lang-js loaded ===\n")
(define-syntax function (syntax-rules () ((_ name (args ...) body ...) (define name (lambda (args ...) body ...)))))
(define-syntax var (syntax-rules (=) ((_ name = val) (define name val)) ((_ name) (define name #f))))
(define-syntax const (syntax-rules (=) ((_ name = val) (define name val))))
(define-syntax console.log (syntax-rules () ((_ x ...) (begin (display x) ... (newline)))))
(define-syntax typeof (syntax-rules () ((_ x) (cond ((number? x) 'number) ((string? x) 'string) ((boolean? x) 'boolean) ((pair? x) 'object) ((procedure? x) 'function) (else 'undefined)))))
(define-syntax === (syntax-rules () ((_ a b) (equal? a b))))
(define-syntax !== (syntax-rules () ((_ a b) (not (equal? a b)))))
(define-macro (for var = start cond inc . body) `(let ((,var ,start)) (let loop () (if ,cond (begin ,@body ,inc (loop)) #f))))
(define-syntax for-of (syntax-rules (of) ((_ var of arr body ...) (for-each (lambda (var) body ...) arr))))
(define-macro (object . pairs) (let loop ((p pairs) (acc '())) (if (null? p) `(list ,@(reverse acc)) (loop (cddr p) (cons `(cons (quote ,(car p)) ,(cadr p)) acc)))))
(define-syntax push (syntax-rules () ((_ arr val) (set! arr (append arr (list val))))))
(define-syntax pop (syntax-rules () ((_ arr) (let ((v (car (reverse arr)))) (set! arr (reverse (cdr (reverse arr)))) v))))
(define-syntax arr-length (syntax-rules () ((_ arr) (length arr))))

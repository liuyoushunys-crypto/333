(display "--- demos ---\n")
(function fib (n)
  (var a = 0)
  (var b = 1)
  (for i = 0 #{i < n} (set! i #{i + 1})
    (var t = #{a + b})
    (set! a b)
    (set! b t))
  (console.log "fib(" n ") = " a))
(fib 10)

(function filter-evens (arr)
  (var result = (list))
  (for-of x of arr
    (if (zero? #{x % 2})
      (push result x)))
  (console.log "evens:" result))
(filter-evens (list 1 2 3 4 5 6))

(function sum-to (n)
  (var total = 0)
  (for i = 1 #{i <= n} (set! i #{i + 1})
    (set! total #{total + i}))
  (console.log "sum 1.." n " = " total))
(sum-to 10)


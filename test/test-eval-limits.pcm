(display "=== _eval Trampoline & Overflow Limits ===\n")
(display "Python recursion limit: 1000 frames\n\n")

(display "--- 1. Tail recursion (works via TailCall trampoline) ---\n")
(test-equal "nlet 100k" 5000050000
  (let loop ((i 100000) (s 0)) (if (zero? i) s (loop (- i 1) (+ s i)))))
(display "  [OK] nlet recursion bypasses Python stack\n")

(display "--- 2. Deep do (trampolined) ---\n")
(test-equal "do 100k" 5000050000
  (do ((i 0 (+ i 1)) (sum 0 (+ sum i))) ((> i 100000) sum)))
(display "  [OK] do loop is trampolined via letrec\n")

(display "--- 3. Macro expansion (~1000 max, if condition adds stack) ---\n")
(define-syntax lim-macro
  (syntax-rules () ((_ n) (if (zero? n) 'done (lim-macro (- n 1))))))
(test-equal "macro 500" 'done (lim-macro 500))
(display "  [NOTE] macro >1000 may overflow: if condition calls _eval directly\n")

(display "--- 4. define-macro (same limit) ---\n")
(define-macro (lim-defmacro n)
  (if (zero? n) ''done `(lim-defmacro ,(- n 1))))
(test-equal "defmacro 500" 'done (lim-defmacro 500))
(display "  [NOTE] defmacro >1000 may overflow\n")

(display "--- 5. Large list operations ---\n")
(define big-lst (iota 50000))
(test-equal "iota 50k length" 50000 (length big-lst))
(test-equal "list-ref last" 49999 (list-ref big-lst 49999))
(test-equal "reverse 50k" 50000 (length (reverse big-lst)))
(test-equal "append 50k+1" 50001 (length (append big-lst '(x))))
(test-equal "map 50k" 50000 (length (map (lambda (x) x) big-lst)))
(test-equal "fold + 50k" 1249975000 (fold + 0 big-lst))
(test-equal "fold-left 50k" 1249975000 (fold-left + 0 big-lst))

(display "--- 6. String operations ---\n")
(test-equal "make-string 100k" 100000 (string-length (make-string 100000 #\x)))
(test-equal "substring" 50000
  (string-length (substring (make-string 100000 #\x) 10000 60000)))
(define csv-str (string-join (make-list 1000 "a") ","))
(test-equal "string-join 1000" 1999 (string-length csv-str))
(test-equal "string-split" 1000 (length (string-split csv-str ",")))

(display "--- 7. Vector operations ---\n")
(define big-vec (make-vector 50000 42))
(test-equal "vector 50k length" 50000 (vector-length big-vec))
(test-equal "vector->list" 50000 (length (vector->list big-vec)))

(display "--- 8. Deep guard/exception (trampolined) ---\n")
(test-equal "guard 10000" 'caught
  (guard (exn (else 'caught))
    (let loop ((n 10000))
      (if (zero? n) (error "bottom")
          (guard (exn (else (loop (- n 1)))) (error "up"))))))
(display "  [OK] guard through named let is trampolined\n")

(display "--- 9. Generate-temporaries stress ---\n")
(define many-temps (generate-temporaries (make-list 1000 'x)))
(test-equal "temps 1000 length" 1000 (length many-temps))
(test-equal "temps all syntax?" #t (every syntax? many-temps))

(display "--- 10. Deep letrec mutual recursion ---\n")
(test-equal "letrec even? 10001" #f
  (letrec ((even? (lambda (n) (if (= n 0) #t (odd? (- n 1)))))
           (odd? (lambda (n) (if (= n 0) #f (even? (- n 1))))))
    (even? 10001)))

(display "--- 11. Generator 100k ---\n")
(define gen-100k (make-iota-generator 100000))
(do ((i 0 (+ i 1))) ((= i 100000)) (gen-100k))
(test-equal "gen 100k exhausted" (eof-object) (gen-100k))

(display "--- 12. Hash-table 10k ---\n")
(define ht-10k (make-eq-hash-table))
(do ((i 0 (+ i 1))) ((= i 10000))
  (hash-table-set! ht-10k (string->symbol (string-append "k" (number->string i))) i))
(test-equal "ht 10k size" 10000 (hash-table-size ht-10k))
(test-equal "ht ref last" 9999 (hash-table-ref ht-10k (string->symbol "k9999")))

(display "\n;; === Trampoline & Overflow limits documented ===\n")
(display ";; Safe limits: tail-rec 100k+, macro 500, lists/strings/vecs 50k+\n")

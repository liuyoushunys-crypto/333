(display "--- demos ---\n")
(function fib (n)
  (julia-set a = 0)
  (julia-set b = 1)
  (for i in (iota n)
    (julia-set t = #{a + b})
    (set! a b)
    (set! b t)
  end)
  (println "fib(" n ") =" a)
end)
(fib 10)

(function filter-evens (lst)
  (julia-set result = (list))
  (for x in lst
    (if (zero? #{x % 2})
      (push! result x))
  end)
  (println "evens:" result)
end)
(filter-evens (list 1 2 3 4 5 6))

(function sum-to (n)
  (julia-set total = 0)
  (julia-set i = 1)
  (while #{i <= n}
    (set! total #{total + i})
    (set! i #{i + 1})
  end)
  (println "sum 1.." n "=" total)
end)
(sum-to 10)


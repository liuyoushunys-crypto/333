(display "=== lang-julia loaded ===\n")
(define-syntax function (syntax-rules (end) ((_ name (args ...) body ... end) (define name (lambda (args ...) body ...)))))
(define-syntax julia-set (syntax-rules (=) ((_ name = val) (define name val))))
(define-syntax return (syntax-rules () ((_ x) x) ((_) #f)))
(define-macro (ifelse . clauses) (let loop ((cs clauses)) (if (null? cs) #f (let ((c (car cs))) (cond ((eq? c 'elseif) `(if ,(cadr cs) (begin ,@(cddr cs)) ,(loop (cdddr cs)))) ((eq? c 'else) `(begin ,@(cdr cs))) ((and (pair? c) ((= (length c) 2))) `(if ,(car c) ,(cadr c) ,(loop (cdr cs)))) (else `(if ,c (begin ,@(cdr cs)) ,(loop (cdr cs)))))))))
(define-syntax for (syntax-rules (in end) ((_ var in iter body ... end) (for-each (lambda (var) body ...) iter))))
(define-syntax while (syntax-rules (end) ((_ cond body ... end) (let loop () (if cond (begin body ... (loop)) #f)))))
(define-syntax println (syntax-rules () ((_ x ...) (begin (display x) ... (newline)))))
(define-syntax push! (syntax-rules () ((_ vec val) (set! vec (append vec (list val))))))
(define-syntax pop! (syntax-rules () ((_ vec) (let ((v (car (reverse vec)))) (set! vec (reverse (cdr (reverse vec)))) v))))
(define-macro (comp expr for var in lst) `(map (lambda (,var) ,expr) ,lst))
(define-syntax typeof (syntax-rules () ((_ x) (cond ((string? x) 'String) ((procedure? x) 'Function) ((number? x) 'Int64) ((boolean? x) 'Bool) ((pair? x) 'Array) (else 'Any)))))
(define-syntax ^ (syntax-rules () ((_ x n) (expt x n))))

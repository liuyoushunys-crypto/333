(display "--- demos ---\n")
(func fib (n)
  (:= a 0)
  (:= b 1)
  (:= i 0)
  (:= t 0)
  (for (set! i 0) #{i < n} (set! i #{i + 1})
    (set! t #{a + b})
    (set! a b)
    (set! b t))
  (fmt.Println "fib(" n ") =" a))
(fib 10)

(func build-range (n)
  (:= s (list))
  (:= i 0)
  (for (set! i 0) #{i < n} (set! i #{i + 1})
    (append s #{i + 1}))
  (fmt.Println "range:" (len s) "items:" s))
(build-range 5)

(func sum-to (n)
  (:= total 0)
  (:= i 1)
  (for (set! i 1) #{i <= n} (set! i #{i + 1})
    (set! total #{total + i}))
  (fmt.Println "sum 1.." n "=" total))
(sum-to 10)


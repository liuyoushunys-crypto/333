(display "=== lang-go loaded ===\n")
(define-syntax func (syntax-rules () ((_ name (args ...) body ...) (define name (lambda (args ...) body ...))) ((_ name (args ...) type body ...) (define name (lambda (args ...) body ...)))))
(define-syntax := (syntax-rules () ((_ name val) (define name val))))
(define-syntax var (syntax-rules (=) ((_ name type = val) (define name val)) ((_ name type) (define name #f))))
(define-syntax return (syntax-rules () ((_ x) x) ((_) #f)))
(define-syntax go-if (syntax-rules (else) ((_ cond then else else2) (if cond then else2)) ((_ cond then) (when cond then))))
(define-macro (for init cond inc . body) `(begin ,init (let loop () (if ,cond (begin ,@body ,inc (loop)) #f))))
(define-macro (switch expr . cases) (let* ((v (gensym)) (cl (map (lambda (c) (if (eq? (car c) 'default) `(else ,@(cdr c)) `((eq? ,v ',(cadr c)) ,@(cddr c)))) cases))) `(let ((,v ,expr)) (cond ,@cl))))
(define-syntax defer (syntax-rules () ((_ body ...) (dynamic-wind (lambda () #f) (lambda () #f) (lambda () body ...)))))
(define-syntax go (syntax-rules () ((_ expr) expr)))
(define-syntax len (syntax-rules () ((_ x) (length x))))
(define go-append append)
(define-macro (append slice val) `(go-append ,slice (list ,val)))
(define-macro (fmt.Println . args) `(begin ,@(map (lambda (a) `(display ,a)) args) (newline)))
(define-syntax idx (syntax-rules (]) ((_ slice [i]) (list-ref slice i))))

(display "--- demos ---\n")
(def fib (n)
  (let ((a 0) (b 1))
    (times n
      (let ((t #{a + b}))
        (set! a b)
        (set! b t)))
    (puts (string-append "fib(" (number->string n) ") = " (number->string a))))
end)
(fib 10)

(def filter-demo (lst)
  (puts (select lst (lambda (x) #{x > 0})))
end)
(filter-demo (list 3 -1 0 5 -2 7))

(def sum-demo (lst)
  (let ((total 0))
    (each_with_index lst (lambda (x i) (set! total #{total + x})))
    (puts (string-append "sum: " (number->string total))))
end)
(sum-demo (list 1 2 3 4 5))


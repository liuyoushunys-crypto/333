(display "=== lang-c loaded ===\n")
(define-syntax int (syntax-rules () ((_ name (args ...) body ...) (define name (lambda (args ...) body ...))) ((_ name) name)))
(define-syntax void (syntax-rules () ((_ name (args ...) body ...) (define name (lambda (args ...) body ...)))))
(define-macro (for init cond inc . body) `(begin ,init (let loop () (if ,cond (begin ,@body ,inc (loop)) #f))))
(define-syntax while (syntax-rules () ((_ (cond) body ...) (let loop () (if cond (begin body ... (loop)) #f)))))
(define-syntax do-while (syntax-rules (while) ((_ body ... while (cond)) (let loop () (begin body ...) (if cond (loop) #f)))))
(define-syntax c-if (syntax-rules (else) ((_ (cond) then else else2) (if cond then else2)) ((_ (cond) then) (when cond then))))
(define-macro (switch expr . cases) (let* ((v (gensym)) (cl (map (lambda (c) (if (eq? (car c) 'default) `(else ,@(cdr c)) `((eq? ,v ',(cadr c)) ,@(cddr c)))) cases))) `(let ((,v ,expr)) (cond ,@cl))))
(define-macro (printf fmt . args) (if (null? args) `(display ,fmt) `(display (format ,fmt ,@args))))
(define-macro (c-def type name . rest) (if (null? rest) `(define ,name #f) `(define ,name ,(car rest))))
(define-syntax ++ (syntax-rules () ((_ x) (begin (set! x #{x + 1}) x))))
(define-syntax -- (syntax-rules () ((_ x) (begin (set! x #{x - 1}) x))))
(define-syntax += (syntax-rules () ((_ x n) (set! x #{x + n}))))
(define-syntax -= (syntax-rules () ((_ x n) (set! x #{x - n}))))
(define-syntax *= (syntax-rules () ((_ x n) (set! x #{x * n}))))
(define-syntax /= (syntax-rules () ((_ x n) (set! x #{x / n}))))
(define-syntax c-ternary (syntax-rules (? :) ((_ cond ? then : else) (if cond then else))))

(display "--- demos ---\n")
(int fib (n)
  (c-def int a 0)
  (c-def int b 1)
  (c-def int i 0)
  (c-def int t 0)
  (for (set! i 0) #{i < n} (set! i #{i + 1})
    (set! t #{a + b})
    (set! a b)
    (set! b t))
  (printf "fib(~a) = ~a~%" n a))
(fib 10)

(int fact (n)
  (c-def int r 1)
  (c-def int i 1)
  (for (set! i 1) #{i <= n} (set! i #{i + 1})
    (set! r #{r * i}))
  (printf "~a! = ~a~%" n r))
(fact 6)

(int sum-evens (n)
  (c-def int total 0)
  (c-def int i 0)
  (for (set! i 0) #{i <= n} (set! i #{i + 1})
    (c-if ((zero? #{i % 2})) (set! total #{total + i})))
  (printf "sum evens <= ~a = ~a~%" n total))
(sum-evens 10)


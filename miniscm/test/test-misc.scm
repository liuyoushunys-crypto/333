(check "condition/report-string" (not (not (procedure? condition/report-string))) #t)
(check "error? in cond" (not (not (procedure? error?))) #t)
(check "file-error? on open" (file-error? (file-error? ()) ) #f)
(check "read-error?" (read-error? '()) #f)


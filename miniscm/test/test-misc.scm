;; test-ext-accuracy.scm — Comprehensive accuracy tests for primitives_ext
;; Each section tests a function category from initenv_ext().

(define _pass 0) (define _fail 0)
(define-syntax check1
  (syntax-rules ()
    ((_ label actual expected)
     (guard (ex (else (begin (display "[FAIL] ") (display label)
                             (display " error: ") (write ex) (newline)
                             (set! _fail (+ _fail 1)))))
       (let ((a actual))
         (if (equal? a expected)
             (begin (display "[PASS] ") (display label) (newline)
                    (set! _pass (+ _pass 1)))
             (begin (display "[FAIL] ") (display label)
                    (display "  expected: ") (display expected)
                    (display "  actual: ") (display actual) (newline)
                    (set! _fail (+ _fail 1)))))))))

(define (check label actual expected)
  (if (equal? actual expected)
      (begin (display "[PASS] ") (display label) (newline))
      (begin (display "[FAIL] ") (display label)
             (display "  expected: ") (display expected)
             (display "  actual: ") (display actual) (newline))))

;;──────────────────── Division (SRFI-141) ────────────────────
(check "atom?" (atom? 5) #t)
(check "atom? pair" (atom? '(1 2)) #f)
(check "void?" (void? (void)) #t)
(check "boolean->string" (boolean->string #t) "#t")
(check "symbol=?" (symbol=? 'a 'a 'a) #t)
(check "symbol=? diff" (symbol=? 'a 'b) #f)
(check "add1" (add1 5) 6)
(check "sub1" (sub1 5) 4)
(check "square" (square 6) 36)
(check "exact" (= (exact 3.0) 3) #t)
(check "inexact" (inexact 3) 3.0)
(check "exact-nonnegative-integer?" (exact-nonnegative-integer? 5) #t)
(check "exact-nonnegative-integer? neg" (exact-nonnegative-integer? -3) #f)
(check "exact-rational?" (exact-rational? 5/2) #t)
(check "exact-rational? int" (exact-rational? 5) #t)
(check "default-object?" (default-object? (void)) #t)
(check "string->vector" (string->vector "abc") #(#\a #\b #\c))
(check "vector->string" (vector->string '#(#\a #\b #\c)) "abc")
(check "string->char-set" (char-set-contains? (string->char-set "abc") #\b) #t)

;;──────────────────── Combinatorics ────────────────────
(define cond1 (make-error-condition 'test "oops"))
  (check "condition?" (not (not (procedure? condition?))) #t)
(check "condition-type?" (not (not (procedure? condition-type?))) #t)
